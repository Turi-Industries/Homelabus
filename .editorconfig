# What every editor should agree on before a formatter runs: rustfmt owns the Rust,
# and the interface is indented with tabs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,js,svelte,css,html}]
indent_style = tab

[*.{yml,yaml,json,toml}]
indent_size = 2

[web/**.json]
indent_style = tab

# Generated by the controller's test, with serde's two spaces.
[web/openapi.json]
indent_style = space

# Two trailing spaces are a line break in Markdown.
[*.md]
trim_trailing_whitespace = false
